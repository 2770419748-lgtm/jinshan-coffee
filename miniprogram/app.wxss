/* 进山咖啡：黑底金色，跟 logo 一致 */
page {
  --bg: #0b0b0b;
  --card: #171615;
  --card-2: #211f1c;
  --line: #2c2925;
  --gold: #d6b25e;
  --gold-soft: rgba(214, 178, 94, 0.14);
  --text: #f2ecdf;
  --text-2: #a39b8b;
  --text-3: #6f685c;
  --danger: #e0715c;
  --ok: #7fbf8a;

  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

view, text, input, textarea, button, scroll-view {
  box-sizing: border-box;
}

.page {
  padding: 24rpx 24rpx 48rpx;
}

.card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 26rpx;
  color: var(--text-2);
  margin: 12rpx 4rpx 16rpx;
}

.gold { color: var(--gold); }
.muted { color: var(--text-2); }
.faint { color: var(--text-3); }
.danger { color: var(--danger); }
.ok { color: var(--ok); }

.price {
  color: var(--gold);
  font-weight: 600;
}
.price::before {
  content: "¥";
  font-size: 0.75em;
  margin-right: 2rpx;
}
.price.big { font-size: 40rpx; }

.btn-gold,
.btn-ghost,
.btn-danger {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  padding: 0 40rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.btn-gold { background: var(--gold); color: #1a1408; }
.btn-ghost { border: 1rpx solid var(--gold); color: var(--gold); }
.btn-danger { border: 1rpx solid var(--danger); color: var(--danger); }
.btn-block { display: flex; width: 100%; }
.btn-small { height: 60rpx; padding: 0 28rpx; font-size: 26rpx; border-radius: 30rpx; }
.btn-gold.disabled, .btn-ghost.disabled { opacity: 0.4; }
.btn-hover { opacity: 0.75; }

.tag {
  display: inline-block;
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  background: var(--card-2);
  color: var(--text-2);
}
.tag.gold { background: var(--gold-soft); color: var(--gold); }
.tag.danger { background: rgba(224, 113, 92, 0.15); color: var(--danger); }
.tag.ok { background: rgba(127, 191, 138, 0.15); color: var(--ok); }

.empty {
  text-align: center;
  color: var(--text-3);
  padding: 80rpx 0;
}

.row {
  display: flex;
  align-items: center;
}
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.flex-1 { flex: 1; min-width: 0; }

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.cell:last-child { border-bottom: none; }
.cell-arrow::after {
  content: "›";
  color: var(--text-3);
  font-size: 36rpx;
  margin-left: 12rpx;
}

/* 底部弹层 */
.mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 90;
}
.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  max-height: 80vh;
  overflow-y: auto;
  background: var(--card);
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  z-index: 100;
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.sheet-title { font-size: 34rpx; font-weight: 600; }
.sheet-close { font-size: 44rpx; color: var(--text-3); padding: 0 8rpx; }

/* 数量加减 */
.stepper {
  display: flex;
  align-items: center;
}
.stepper-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  border: 1rpx solid var(--gold);
  color: var(--gold);
}
.stepper-btn.plus { background: var(--gold); color: #1a1408; }
.stepper-num { min-width: 64rpx; text-align: center; }

/* 表单 */
.field {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.field:last-child { border-bottom: none; }
.field-label {
  width: 160rpx;
  color: var(--text-2);
  flex-shrink: 0;
}
.field-input {
  flex: 1;
  color: var(--text);
  font-size: 28rpx;
}
.placeholder { color: var(--text-3); }

.chips {
  display: flex;
  flex-wrap: wrap;
}
.chip {
  padding: 12rpx 28rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 12rpx;
  border: 1rpx solid var(--line);
  background: var(--card-2);
  color: var(--text);
  font-size: 26rpx;
}
.chip.on {
  border-color: var(--gold);
  background: var(--gold-soft);
  color: var(--gold);
}

.safe-bottom { height: calc(140rpx + env(safe-area-inset-bottom)); }
