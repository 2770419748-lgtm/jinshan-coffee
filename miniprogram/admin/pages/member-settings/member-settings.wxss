.small {
  font-size: 22rpx;
}
.note {
  margin-top: 12rpx;
  line-height: 1.6;
}
.notice {
  width: 100%;
  min-height: 80rpx;
  color: var(--text);
  font-size: 28rpx;
}
.save {
  margin: 8rpx 0 24rpx;
}
.plans-head {
  margin-top: 12rpx;
}
.add {
  font-size: 26rpx;
  margin-right: 4rpx;
}
.plan {
  display: flex;
  align-items: center;
}
.plan.off .info {
  opacity: 0.4;
}
.moves {
  display: flex;
  flex-direction: column;
  margin-right: 16rpx;
}
.move {
  padding: 4rpx 12rpx;
  font-size: 30rpx;
  color: var(--gold);
}
.move.faint {
  color: var(--text-3);
}
.info {
  margin-right: 12rpx;
}
.title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gold);
}
.side {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.switch {
  transform: scale(0.75);
}
