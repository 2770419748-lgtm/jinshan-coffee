.who {
  display: flex;
  align-items: center;
  padding: 16rpx 8rpx 36rpx;
}
.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  border: 2rpx solid var(--gold);
  margin-right: 24rpx;
}
.who-line {
  display: flex;
  align-items: center;
}
.who-name {
  font-size: 38rpx;
  font-weight: 600;
  margin-right: 16rpx;
}
.who-sub {
  font-size: 24rpx;
  margin-top: 6rpx;
}
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.tile {
  width: 48.5%;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
}
/* 每天最常用的入口占一整行，和「我的」页的余额卡一样的金色渐变 */
.tile.primary {
  width: 100%;
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  border-color: rgba(214, 178, 94, 0.45);
  background: linear-gradient(135deg, #2a2316 0%, #171615 70%);
}
.tile.primary .tile-title { font-size: 36rpx; }
.tile-go {
  font-size: 44rpx;
  line-height: 1;
  color: var(--gold);
  margin-left: 16rpx;
}
.tile.disabled { opacity: 0.4; }
.tile-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--gold);
}
.tile-sub {
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 8rpx;
}
