.cat-bar {
  display: flex;
  white-space: nowrap;
  padding: 20rpx 24rpx 4rpx;
}
.cat-bar .chip {
  flex-shrink: 0;
}
.product {
  display: flex;
  align-items: center;
  padding: 20rpx;
}
.product.off .img,
.product.off .name {
  opacity: 0.4;
}
.img {
  width: 128rpx;
  height: 128rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background: var(--card-2);
}
.name {
  font-size: 30rpx;
  font-weight: 600;
}
.small {
  font-size: 22rpx;
  margin: 4rpx 0 8rpx;
}
.sold {
  font-size: 24rpx;
  color: var(--text-2);
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  margin-right: 16rpx;
}
.sold.on {
  color: var(--danger);
  border-color: var(--danger);
}
.shelf {
  transform: scale(0.8);
}
.tip {
  font-size: 24rpx;
  text-align: center;
  margin-top: 8rpx;
}
.empty-box {
  padding: 0 60rpx;
}
.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.5);
}
