<view class="page" wx:if="{{ready}}">
  <view class="card">
    <view class="field">
      <text class="field-label">减多少（元）</text>
      <input class="field-input" type="digit" placeholder="比如 5" placeholder-class="placeholder" value="{{form.amountText}}" data-field="amountText" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="field-label">满多少可用</text>
      <input class="field-input" type="digit" placeholder="元，不填就是无门槛" placeholder-class="placeholder" value="{{form.minText}}" data-field="minText" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="field-label">名称</text>
      <input class="field-input" placeholder="{{titleHint}}" placeholder-class="placeholder" maxlength="16" value="{{form.title}}" data-field="title" bindinput="onInput" />
    </view>
  </view>

  <view class="card">
    <view class="field">
      <text class="field-label">有效天数</text>
      <input class="field-input" type="number" placeholder="领取当天算第 1 天" placeholder-class="placeholder" value="{{form.validDays}}" data-field="validDays" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="field-label">一共发几张</text>
      <input class="field-input" type="number" placeholder="不填就是不限量" placeholder-class="placeholder" value="{{form.total}}" data-field="total" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="field-label">每人限领</text>
      <view class="field-input">
        <view class="stepper">
          <view class="stepper-btn" data-delta="-1" bindtap="changePerUser">−</view>
          <text class="stepper-num">{{form.perUser}}</text>
          <view class="stepper-btn plus" data-delta="1" bindtap="changePerUser">+</view>
        </view>
      </view>
    </view>
    <view class="field">
      <text class="field-label">发放</text>
      <view class="field-input"><switch checked="{{form.enabled}}" color="#d6b25e" bindchange="onEnabled" /></view>
    </view>
  </view>

  <view class="faint note" wx:if="{{claimed}}">已经领走 {{claimed}} 张。改金额、门槛只影响之后领的券，已领的按领取时的算。</view>
  <view class="faint note">门槛按用完赠饮券以后还要付的钱算，最多抵到 0 元。</view>

  <view class="btn-gold btn-block save {{saving ? 'disabled' : ''}}" bindtap="save">{{saving ? '保存中…' : '保存'}}</view>
  <view class="btn-danger btn-block" wx:if="{{id}}" bindtap="remove">删除这张券</view>
  <view class="safe-bottom"></view>
</view>
