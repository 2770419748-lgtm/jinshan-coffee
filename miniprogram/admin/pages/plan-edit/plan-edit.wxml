<view class="page" wx:if="{{ready}}">
  <view class="card">
    <view class="field">
      <text class="field-label">充多少（元）</text>
      <input class="field-input" type="digit" placeholder="顾客付的钱，比如 300" placeholder-class="placeholder" value="{{form.priceText}}" data-field="priceText" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="field-label">送多少（元）</text>
      <input class="field-input" type="digit" placeholder="比如 100，不送就空着" placeholder-class="placeholder" value="{{form.bonusText}}" data-field="bonusText" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="field-label">送会员天数</text>
      <input class="field-input" type="number" placeholder="一年填 365，不送就空着" placeholder-class="placeholder" value="{{form.memberDays}}" data-field="memberDays" bindinput="onInput" />
    </view>
  </view>

  <view class="card">
    <view class="field">
      <text class="field-label">名称</text>
      <input class="field-input" placeholder="不填自动叫「充 300 送 100」" placeholder-class="placeholder" maxlength="16" value="{{form.title}}" data-field="title" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="field-label">说明</text>
      <input class="field-input" placeholder="选填，比如「最划算」" placeholder-class="placeholder" maxlength="40" value="{{form.desc}}" data-field="desc" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="field-label">上架</text>
      <view class="field-input"><switch checked="{{form.enabled}}" color="#d6b25e" bindchange="onEnabled" /></view>
    </view>
  </view>

  <view class="faint note">会员天数从充值当天算第 1 天；已经是会员的，从原来的到期日往后加。</view>
  <view class="faint note">改金额只影响以后的充值，已经充进去的钱不变。</view>

  <view class="btn-gold btn-block save {{saving ? 'disabled' : ''}}" bindtap="save">{{saving ? '保存中…' : '保存'}}</view>
  <view class="btn-danger btn-block" wx:if="{{id}}" bindtap="remove">删除这个档位</view>
  <view class="safe-bottom"></view>
</view>
