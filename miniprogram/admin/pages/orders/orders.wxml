<wxs src="../../../utils/filters.wxs" module="f" />

<view wx:if="{{ready}}">
  <view class="tabs">
    <view wx:for="{{tabs}}" wx:key="key" class="tab {{current === item.key ? 'on' : ''}}" data-key="{{item.key}}" bindtap="switchTab">
      {{item.name}}<text class="tab-count" wx:if="{{counts[item.key]}}">{{counts[item.key]}}</text>
    </view>
  </view>

  <view class="toolbar">
    <text class="faint">今天的订单 · 停在本页时自动刷新</text>
    <text class="sound {{soundOn ? 'gold' : 'faint'}}" bindtap="toggleSound">{{soundOn ? '响铃开' : '响铃关'}}</text>
  </view>

  <view class="page">
    <view wx:for="{{orders}}" wx:key="_id" class="card order">
      <view class="row-between">
        <view class="row">
          <text class="pickup">{{item.pickupNo}}</text>
          <text class="tag gold where reserve" wx:if="{{item.reserveAt}}">预约 {{f.clock(item.reserveAt)}}</text>
          <text class="tag gold where" wx:if="{{item.tableNo}}">{{item.tableNo}} 号桌</text>
          <text class="tag where" wx:else>{{f.mode(item.mode)}}</text>
        </view>
        <text class="faint">{{f.clock(item.createdAt)}}</text>
      </view>

      <view class="items">
        <view wx:for="{{item.items}}" wx:for-item="line" class="item-line">
          <text class="flex-1">{{line.name}}<text class="faint" wx:if="{{line.specs.length}}">（{{f.specText(line.specs)}}）</text></text>
          <text class="qty">×{{line.qty}}</text>
        </view>
      </view>
      <view class="remark" wx:if="{{item.remark}}">备注：{{item.remark}}</view>

      <!-- 外送：地址、配送进度、叫骑手 -->
      <view class="delivery" wx:if="{{item.delivery}}">
        <view class="row-between">
          <text class="gold">外送 · {{item.delivery.statusText}}<text wx:if="{{item.delivery.carrierName}}">（{{item.delivery.carrierName}}）</text><text class="faint" wx:if="{{item.delivery.sandbox}}"> 测试单</text></text>
          <text class="faint">{{item.delivery.distanceKm}} 公里</text>
        </view>
        <view class="addr">{{item.delivery.address.place}} {{item.delivery.address.detail}}</view>
        <view class="muted">{{item.delivery.address.name}} <text class="gold" data-phone="{{item.delivery.address.phone}}" bindtap="callPhone">{{item.delivery.address.phone}}</text></view>
        <view class="muted" wx:if="{{item.delivery.rider}}">骑手 {{item.delivery.rider.name}} <text class="gold" data-phone="{{item.delivery.rider.phone}}" bindtap="callPhone">{{item.delivery.rider.phone}}</text></view>
        <view class="muted" wx:if="{{item.delivery.fetchCode}}">取货码 <text class="gold">{{item.delivery.fetchCode}}</text></view>
        <view class="danger small" wx:if="{{item.delivery.error}}">{{item.delivery.error}}</view>
        <view class="faint small" wx:elif="{{item.delivery.note}}">{{item.delivery.note}}</view>
        <view class="row courier-ops" wx:if="{{item.ops}}">
          <view wx:if="{{item.ops.call}}" class="btn-gold btn-small" data-id="{{item._id}}" data-op="call" bindtap="courierAct">叫骑手</view>
          <view wx:if="{{item.ops.self}}" class="btn-ghost btn-small" data-id="{{item._id}}" data-op="self" bindtap="courierAct">店员送出</view>
          <view wx:if="{{item.ops.delivered}}" class="btn-gold btn-small" data-id="{{item._id}}" data-op="delivered" bindtap="courierAct">已送达</view>
          <view wx:if="{{item.ops.refresh}}" class="btn-ghost btn-small" data-id="{{item._id}}" data-op="refresh" bindtap="courierAct">刷新</view>
          <view wx:if="{{item.ops.mock}}" class="btn-ghost btn-small" data-id="{{item._id}}" data-op="mock" bindtap="courierAct">模拟{{item.ops.mockText}}</view>
          <view wx:if="{{item.ops.cancel}}" class="btn-danger btn-small" data-id="{{item._id}}" data-op="cancel" bindtap="courierAct">取消配送</view>
        </view>
      </view>
      <view class="star-line" wx:if="{{item.starRedeem}}">集星换一杯：{{item.starRedeem.name}}（-¥{{f.yuan(item.starFee)}}）</view>

      <view class="row-between foot">
        <view class="row">
          <text class="price">{{f.yuan(item.payFee)}}</text>
          <text class="tag {{item.payStatus === 'paid' ? 'ok' : item.payStatus === 'refunded' ? '' : 'danger'}} pay">{{f.payTag(item.payStatus, item.payMethod)}}</text>
        </view>
        <view class="row ops">
          <view wx:if="{{item.payStatus === 'unpaid' && item.status !== 'cancelled'}}" class="btn-ghost btn-small" data-id="{{item._id}}" data-op="paid" bindtap="act">已收款</view>
          <view wx:if="{{item.status === 'pending'}}" class="btn-gold btn-small" data-id="{{item._id}}" data-op="making" bindtap="act">开始制作</view>
          <view wx:if="{{item.status === 'making'}}" class="btn-gold btn-small" data-id="{{item._id}}" data-op="done" bindtap="act">制作完成</view>
        </view>
      </view>
      <view class="cancel-link" wx:if="{{item.status === 'pending' || item.status === 'making'}}" data-id="{{item._id}}" data-op="cancelled" bindtap="act">取消订单</view>
    </view>

    <view class="empty" wx:if="{{!loading && !orders.length}}">暂时没有{{current === 'pending' ? '待制作的' : ''}}订单</view>
    <view class="empty" wx:elif="{{loading}}">加载中…</view>
  </view>
</view>
