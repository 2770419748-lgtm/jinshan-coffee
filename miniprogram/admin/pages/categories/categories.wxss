.list {
  padding-top: 0;
  padding-bottom: 0;
}
.count {
  margin-left: 16rpx;
  font-size: 24rpx;
}
.op {
  padding: 0 16rpx;
  color: var(--gold);
  font-size: 30rpx;
}
.op.off {
  color: var(--text-3);
  opacity: 0.4;
}
.op.danger {
  color: var(--danger);
  font-size: 26rpx;
}
.tip {
  font-size: 24rpx;
  text-align: center;
  margin-bottom: 24rpx;
}
.add {
  margin-top: 16rpx;
}
