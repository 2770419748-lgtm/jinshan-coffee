// WXML 里用的格式化函数（WXS 只支持 ES5 写法）
function yuan(fen) {
  var s = ((fen || 0) / 100).toFixed(2)
  if (s.substring(s.length - 3) === '.00') return s.substring(0, s.length - 3)
  if (s.substring(s.length - 1) === '0') return s.substring(0, s.length - 1)
  return s
}

var STATUS = { pending: '待制作', making: '制作中', done: '已完成', cancelled: '已取消' }
var MODE = { dine_in: '堂食', takeaway: '外带', delivery: '外送' }
var RENTAL_STATUS = { pending: '待取书', reading: '阅读中', returned: '已归还', cancelled: '已取消' }
var RULE_TYPE = { hourly: '按小时', day: '包天' }
var BANNER_TAG = { product: '新品', book: '新书', coupons: '领券', none: '进山' }

function status(s) {
  return STATUS[s] || s
}

function mode(m) {
  return MODE[m] || m
}

function pad(n) {
  return n < 10 ? '0' + n : '' + n
}

// 店在中国，时间都按北京时间显示，不管手机或电脑设的是哪个时区
function cn(value) {
  return getDate(getDate(value).getTime() + 8 * 3600 * 1000)
}

function time(value) {
  if (!value) return ''
  var d = cn(value)
  return (d.getUTCMonth() + 1) + '-' + pad(d.getUTCDate()) + ' ' + pad(d.getUTCHours()) + ':' + pad(d.getUTCMinutes())
}

function clock(value) {
  if (!value) return ''
  var d = cn(value)
  return pad(d.getUTCHours()) + ':' + pad(d.getUTCMinutes())
}

function rentalStatus(s) {
  return RENTAL_STATUS[s] || s
}

function ruleType(t) {
  return RULE_TYPE[t] || t
}

// 分钟数写成「1 小时 20 分钟」
function minutes(m) {
  var n = Math.max(0, Math.round(m || 0))
  var h = Math.floor(n / 60)
  var rest = n % 60
  if (!h) return rest + ' 分钟'
  return h + ' 小时' + (rest ? ' ' + rest + ' 分钟' : '')
}

// 在读的书离到期还有多久：dueAtMs 到期时间，now 当前时间（都是毫秒）
function left(dueAtMs, now) {
  if (!dueAtMs) return ''
  var diff = Math.round((dueAtMs - now) / 60000)
  if (diff >= 0) return '还剩 ' + minutes(diff)
  return '已超时 ' + minutes(-diff)
}

function bannerTag(kind) {
  return BANNER_TAG[kind] || '进山'
}

// 代金券的使用条件
function couponRule(c) {
  return c.minSpend ? '满 ' + yuan(c.minSpend) + ' 元可用' : '无门槛'
}

// 2026-10-31 → 10-31
function shortDay(day) {
  return day ? String(day).substring(5) : ''
}

function rentalBrief(r) {
  if (r.ruleType === 'hourly') return r.ruleName + ' · ' + r.hours + ' 小时'
  return r.ruleName
}

// 外送的配送费规则：起步 3 公里 5 元，超出每公里加 2 元；商品满 100 元免配送费
function deliveryRule(r) {
  if (!r) return ''
  var parts = []
  if (!r.baseFee && !r.perKmFee) parts.push('免配送费')
  else if (r.perKmFee && r.baseKm) parts.push(r.baseKm + ' 公里内' + (r.baseFee ? ' ' + yuan(r.baseFee) + ' 元' : '免费') + '，超出每公里加 ' + yuan(r.perKmFee) + ' 元')
  else if (r.perKmFee) parts.push((r.baseFee ? '起步 ' + yuan(r.baseFee) + ' 元，' : '') + '每公里 ' + yuan(r.perKmFee) + ' 元')
  else parts.push('配送费 ' + yuan(r.baseFee) + ' 元')
  if (r.freeAbove && (r.baseFee || r.perKmFee)) parts.push('商品满 ' + yuan(r.freeAbove) + ' 元免配送费')
  parts.push('送 ' + r.radiusKm + ' 公里内')
  return parts.join('；')
}

function specText(specs) {
  var out = []
  for (var i = 0; i < (specs || []).length; i++) out.push(specs[i].option)
  return out.join(' / ')
}

function itemsBrief(items) {
  var list = items || []
  var names = []
  var count = 0
  for (var i = 0; i < list.length; i++) {
    count += list[i].qty
    if (i < 2) names.push(list[i].name + '×' + list[i].qty)
  }
  return names.join('，') + (list.length > 2 ? ' 等' : '') + ' 共 ' + count + ' 件'
}

// 后台列表里的收款状态
function payTag(status, method) {
  if (status === 'refunded') return '已退款'
  if (status !== 'paid') return '未收款'
  if (method === 'wechat') return '微信已付'
  if (method === 'voucher') return '券抵扣'
  if (method === 'balance') return '余额已付'
  if (method === 'member') return '会员免费'
  return '已收款'
}

// 顾客看的付款方式，比如「（会员余额）」
var PAY_METHOD = { wechat: '微信支付', voucher: '券抵扣', balance: '会员余额', member: '会员免费', free: '免费' }
function payMethod(method) {
  return PAY_METHOD[method] ? '（' + PAY_METHOD[method] + '）' : ''
}

// 数组里有没有这一项（WXML 里不能直接调数组方法）
function indexOf(list, item) {
  for (var i = 0; i < (list || []).length; i++) if (list[i] === item) return i
  return -1
}

// 余额变动：+400 / -32
function signed(fen) {
  return (fen > 0 ? '+' : (fen < 0 ? '-' : '')) + yuan(Math.abs(fen || 0))
}

module.exports = {
  payMethod: payMethod,
  signed: signed,
  indexOf: indexOf,
  bannerTag: bannerTag,
  couponRule: couponRule,
  shortDay: shortDay,
  payTag: payTag,
  yuan: yuan,
  status: status,
  mode: mode,
  time: time,
  clock: clock,
  specText: specText,
  deliveryRule: deliveryRule,
  itemsBrief: itemsBrief,
  rentalStatus: rentalStatus,
  ruleType: ruleType,
  minutes: minutes,
  left: left,
  rentalBrief: rentalBrief
}
