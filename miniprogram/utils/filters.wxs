// WXML 里用的格式化函数（WXS 只支持 ES5 写法）
function yuan(fen) {
  var s = ((fen || 0) / 100).toFixed(2)
  if (s.substring(s.length - 3) === '.00') return s.substring(0, s.length - 3)
  if (s.substring(s.length - 1) === '0') return s.substring(0, s.length - 1)
  return s
}

var STATUS = { pending: '待制作', making: '制作中', done: '已完成', cancelled: '已取消' }
var MODE = { dine_in: '堂食', takeaway: '外带' }
var RENTAL_STATUS = { pending: '待取书', reading: '阅读中', returned: '已归还', cancelled: '已取消' }
var RULE_TYPE = { hourly: '按小时', day: '包天' }

function status(s) {
  return STATUS[s] || s
}

function mode(m) {
  return MODE[m] || m
}

function pad(n) {
  return n < 10 ? '0' + n : '' + n
}

function time(value) {
  if (!value) return ''
  var d = getDate(value)
  return (d.getMonth() + 1) + '-' + pad(d.getDate()) + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes())
}

function clock(value) {
  if (!value) return ''
  var d = getDate(value)
  return pad(d.getHours()) + ':' + pad(d.getMinutes())
}

function rentalStatus(s) {
  return RENTAL_STATUS[s] || s
}

function ruleType(t) {
  return RULE_TYPE[t] || t
}

// 分钟数写成「1 小时 20 分钟」
function minutes(m) {
  var n = Math.max(0, Math.round(m || 0))
  var h = Math.floor(n / 60)
  var rest = n % 60
  if (!h) return rest + ' 分钟'
  return h + ' 小时' + (rest ? ' ' + rest + ' 分钟' : '')
}

// 在读的书离到期还有多久：dueAtMs 到期时间，now 当前时间（都是毫秒）
function left(dueAtMs, now) {
  if (!dueAtMs) return ''
  var diff = Math.round((dueAtMs - now) / 60000)
  if (diff >= 0) return '还剩 ' + minutes(diff)
  return '已超时 ' + minutes(-diff)
}

function rentalBrief(r) {
  if (r.ruleType === 'hourly') return r.ruleName + ' · ' + r.hours + ' 小时'
  return r.ruleName
}

function specText(specs) {
  var out = []
  for (var i = 0; i < (specs || []).length; i++) out.push(specs[i].option)
  return out.join(' / ')
}

function itemsBrief(items) {
  var list = items || []
  var names = []
  var count = 0
  for (var i = 0; i < list.length; i++) {
    count += list[i].qty
    if (i < 2) names.push(list[i].name + '×' + list[i].qty)
  }
  return names.join('，') + (list.length > 2 ? ' 等' : '') + ' 共 ' + count + ' 件'
}

// 后台列表里的收款状态
function payTag(status, method) {
  if (status === 'refunded') return '已退款'
  if (status !== 'paid') return '未收款'
  if (method === 'wechat') return '微信已付'
  if (method === 'voucher') return '券抵扣'
  return '已收款'
}

module.exports = {
  payTag: payTag,
  yuan: yuan,
  status: status,
  mode: mode,
  time: time,
  clock: clock,
  specText: specText,
  itemsBrief: itemsBrief,
  rentalStatus: rentalStatus,
  ruleType: ruleType,
  minutes: minutes,
  left: left,
  rentalBrief: rentalBrief
}
