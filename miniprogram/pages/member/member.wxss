/* 会员卡：黑金卡片，左上角 logo，中间大字余额 */
.vip {
  position: relative;
  padding: 36rpx 36rpx 28rpx;
  margin-bottom: 24rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(214, 178, 94, 0.6);
  background: linear-gradient(135deg, #3a2f1a 0%, #1b1813 45%, #0f0e0c 100%);
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.5);
  overflow: hidden;
}
.vip::after {
  content: "";
  position: absolute;
  right: -120rpx;
  top: -160rpx;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(214, 178, 94, 0.18);
}
.vip-top {
  display: flex;
  align-items: center;
}
.vip-logo {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 1rpx solid rgba(214, 178, 94, 0.5);
}
.vip-brand {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--gold);
  letter-spacing: 6rpx;
}
.vip-status {
  font-size: 22rpx;
  color: var(--text-2);
}
.vip-badge {
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background: var(--gold);
  color: #1a1408;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.vip-label {
  margin-top: 40rpx;
  font-size: 24rpx;
  color: var(--text-2);
}
.vip-balance {
  font-size: 80rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.15;
  letter-spacing: 2rpx;
}
.vip-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(214, 178, 94, 0.2);
  font-size: 24rpx;
  color: var(--text-2);
}
.vip-no {
  margin-left: 8rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--gold);
  letter-spacing: 4rpx;
}
.vip-logs {
  color: var(--gold);
}
.perk-title {
  font-size: 30rpx;
  font-weight: 600;
}
.perk .muted {
  margin-top: 8rpx;
}
.perk-note {
  margin-top: 8rpx;
}
.small {
  font-size: 24rpx;
}
.plans {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.plan {
  width: calc(50% - 12rpx);
  margin-bottom: 24rpx;
  padding: 28rpx 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--line);
  background: var(--card);
  text-align: center;
}
.plan.on {
  border-color: var(--gold);
  background: linear-gradient(160deg, #2a2316 0%, #171615 80%);
}
.plan-price {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.2;
}
.plan.on .plan-price {
  color: var(--gold);
}
.yen {
  font-size: 28rpx;
  margin-right: 4rpx;
}
.plan-bonus {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: var(--gold);
}
.plan-bonus.none {
  color: var(--text-3);
}
.plan-days {
  display: inline-block;
  margin-top: 10rpx;
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
  background: var(--gold-soft);
  color: var(--gold);
  font-size: 22rpx;
}
.plan-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-3);
}
.counter {
  border-color: var(--gold);
}
.counter-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.notice {
  margin: 8rpx 8rpx 0;
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.6;
}
.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #121110;
  border-top: 1rpx solid var(--line);
}
