.head {
  display: flex;
}
.cover {
  width: 200rpx;
  height: 280rpx;
  border-radius: 12rpx;
  background: var(--card-2);
  flex-shrink: 0;
}
.cover-text {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  text-align: center;
  color: var(--gold);
  font-weight: 600;
  background: linear-gradient(160deg, #2a2316, #171615);
  border: 1rpx solid var(--line);
}
.info {
  margin-left: 28rpx;
  display: flex;
  flex-direction: column;
}
.title {
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}
.stock {
  margin-top: auto;
  align-self: flex-start;
}
.desc {
  color: var(--text-2);
  line-height: 1.7;
}
.rule.on {
  border-color: var(--gold);
  background: linear-gradient(135deg, #2a2316, #171615);
}
.rule-name {
  font-size: 32rpx;
  font-weight: 600;
}
.free {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--gold);
}
.note {
  font-size: 24rpx;
  margin-top: 16rpx;
}
.remark {
  color: var(--text);
}
.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #121110;
  border-top: 1rpx solid var(--line);
}
.pay-chip {
  margin: 0 0 0 16rpx;
  padding: 8rpx 20rpx;
}
