.active {
  display: flex;
  align-items: center;
  border-color: var(--gold);
}
.active-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 4rpx;
}
.rules-head {
  font-weight: 600;
  color: var(--gold);
  margin-bottom: 8rpx;
}
.rule-line {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
}
.rules-tip {
  font-size: 24rpx;
  margin-top: 8rpx;
}
.cat-bar {
  display: flex;
  white-space: nowrap;
  margin-bottom: 8rpx;
}
.cat-bar .chip {
  flex-shrink: 0;
}
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.book {
  width: 31.5%;
  margin-bottom: 28rpx;
}
.cover {
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
  background: var(--card-2);
  display: block;
}
.cover-text {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  text-align: center;
  color: var(--gold);
  font-size: 30rpx;
  font-weight: 600;
  border: 1rpx solid var(--line);
  background: linear-gradient(160deg, #2a2316, #171615);
}
.title {
  margin-top: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.author {
  font-size: 22rpx;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rules-member {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--line);
  font-size: 24rpx;
  color: var(--text-2);
}
.member-free {
  margin-left: 8rpx;
  border: 1rpx solid rgba(214, 178, 94, 0.5);
  background: transparent;
  color: var(--gold);
}
