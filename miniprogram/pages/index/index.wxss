.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 40rpx;
}
.logo {
  width: 420rpx;
  height: 420rpx;
}
.hero-sub {
  color: var(--text-2);
  letter-spacing: 4rpx;
  margin-top: 8rpx;
}
.active {
  display: flex;
  align-items: center;
  border-color: var(--gold);
}
.active-no {
  font-size: 36rpx;
  font-weight: 600;
  margin-top: 4rpx;
}
.table-tip {
  text-align: center;
  color: var(--text-2);
  margin-bottom: 24rpx;
}
.entry {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
}
.entry.primary {
  background: linear-gradient(135deg, #2a2316, #171615);
  border-color: var(--gold);
}
.entry.disabled { opacity: 0.45; }
.entry-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--gold);
}
.entry-sub {
  color: var(--text-2);
  margin-top: 8rpx;
}
