.list {
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}
.log {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.log:last-child {
  border-bottom: none;
}
.log-right {
  margin-left: 20rpx;
  text-align: right;
}
.amount {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}
.amount.plus {
  color: var(--gold);
}
.small {
  font-size: 22rpx;
}
.more {
  text-align: center;
  font-size: 24rpx;
  padding: 16rpx 0 40rpx;
}
