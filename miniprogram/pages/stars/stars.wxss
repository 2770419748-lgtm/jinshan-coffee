/* 集星卡：和会员卡一样的黑金色 */
.star-card {
  padding: 36rpx 36rpx 28rpx;
  margin-bottom: 24rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(214, 178, 94, 0.6);
  background: linear-gradient(135deg, #3a2f1a 0%, #1b1813 45%, #0f0e0c 100%);
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.5);
}
.star-brand {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--gold);
  letter-spacing: 4rpx;
}
.star-count {
  margin-top: 20rpx;
}
.star-num {
  font-size: 80rpx;
  font-weight: 700;
  line-height: 1.15;
}
.dots {
  display: flex;
  flex-wrap: wrap;
  margin: 16rpx 0 8rpx;
}
.dot {
  width: 10%;
  font-size: 40rpx;
  line-height: 1.5;
  color: var(--text-3);
  text-align: center;
}
.dot.on {
  color: var(--gold);
}
.bar {
  height: 16rpx;
  margin: 20rpx 0 12rpx;
  border-radius: 8rpx;
  background: var(--card-2);
  overflow: hidden;
}
.bar-in {
  height: 100%;
  background: var(--gold);
}
.star-tip {
  margin: 8rpx 0 6rpx;
  font-size: 28rpx;
}
.go {
  margin-bottom: 32rpx;
}
.rule {
  font-size: 26rpx;
  line-height: 1.7;
  margin-bottom: 8rpx;
}
.rule:last-child {
  margin-bottom: 0;
}
.list {
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}
.log {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.log:last-child {
  border-bottom: none;
}
.log-right {
  margin-left: 20rpx;
  text-align: right;
}
.amount {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}
.amount.plus {
  color: var(--gold);
}
.small {
  font-size: 22rpx;
}
.more {
  text-align: center;
  font-size: 24rpx;
  padding: 16rpx 0 40rpx;
}
