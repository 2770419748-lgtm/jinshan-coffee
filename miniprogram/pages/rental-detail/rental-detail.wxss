.code-card {
  text-align: center;
  padding: 40rpx 28rpx;
}
.code {
  font-size: 110rpx;
  font-weight: 700;
  color: var(--gold);
  line-height: 1.2;
  letter-spacing: 8rpx;
}
.status {
  font-size: 32rpx;
  margin-top: 8rpx;
}
.status.returned { color: var(--ok); }
.status.cancelled { color: var(--text-3); }
.steps {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 32rpx 0 8rpx;
}
.step {
  font-size: 24rpx;
  color: var(--text-3);
}
.step.on { color: var(--gold); }
.step-line {
  width: 80rpx;
  height: 2rpx;
  margin: 0 16rpx;
  background: var(--line);
}
.step-line.on { background: var(--gold); }
.tip {
  margin-top: 28rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: var(--gold-soft);
}
.tip.ok {
  background: rgba(127, 191, 138, 0.12);
  color: var(--ok);
}
.tip.warn {
  background: rgba(224, 113, 92, 0.15);
}
.left {
  font-size: 40rpx;
  font-weight: 700;
}
.tip.warn .left { color: var(--danger); }
.vouchers {
  display: flex;
  align-items: center;
  border-color: var(--gold);
}
.go-menu {
  margin-left: 16rpx;
}
.actions .btn-block {
  margin-bottom: 20rpx;
}
