<wxs src="../../utils/filters.wxs" module="f" />

<view class="page">
  <view wx:for="{{usable}}" wx:key="_id" class="card voucher">
    <view class="flex-1">
      <view class="v-title">{{item.title}}</view>
      <view class="muted">{{item.productNames.length ? '可换：' : '任选一杯饮品'}}<text wx:for="{{item.productNames}}" wx:for-item="n" wx:for-index="ni" wx:key="*this">{{ni ? '、' : ''}}{{n}}</text></view>
      <view class="faint small">今天有效<text wx:if="{{item.maxFee}}">，每杯最多抵 ¥{{f.yuan(item.maxFee)}}</text></view>
    </view>
    <view class="btn-gold btn-small" bindtap="goMenu">去点单</view>
  </view>
  <view class="faint tip" wx:if="{{usable.length}}">点单结算时会自动用上，不用出示。</view>

  <view class="empty" wx:if="{{loading}}">加载中…</view>
  <view class="empty" wx:elif="{{!usable.length}}">没有能用的赠饮券。借书选「包天送咖啡」付款后会发到这里。</view>

  <block wx:if="{{others.length}}">
    <view class="section-title">用过和过期的</view>
    <view wx:for="{{others}}" wx:key="_id" class="card voucher off">
      <view class="flex-1">
        <view>{{item.title}}</view>
        <view class="faint small">{{item.day}}</view>
      </view>
      <text class="tag">{{item.status === 'used' ? '已使用' : item.status === 'expired' ? '已过期' : '已作废'}}</text>
    </view>
  </block>
</view>
