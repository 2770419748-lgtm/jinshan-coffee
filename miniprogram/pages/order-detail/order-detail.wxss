.pickup-card {
  text-align: center;
  padding: 40rpx 28rpx;
}
.pickup-no {
  font-size: 120rpx;
  font-weight: 700;
  color: var(--gold);
  line-height: 1.2;
  letter-spacing: 8rpx;
}
.status {
  font-size: 32rpx;
  margin-top: 8rpx;
}
.status.done { color: var(--ok); }
.status.cancelled { color: var(--text-3); }
.steps {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 32rpx 0 8rpx;
}
.step {
  font-size: 24rpx;
  color: var(--text-3);
}
.step.on { color: var(--gold); }
.step-line {
  width: 80rpx;
  height: 2rpx;
  margin: 0 16rpx;
  background: var(--line);
}
.step-line.on { background: var(--gold); }
.pay-tip {
  margin-top: 28rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: var(--gold-soft);
  color: var(--text);
}
.pay-tip.ok {
  background: rgba(127, 191, 138, 0.12);
  color: var(--ok);
}
.info-row {
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--line);
}
.line {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}
.qty {
  margin: 0 24rpx;
}
.total-row {
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
}
.actions .btn-block {
  margin-bottom: 20rpx;
}
.sub-row {
  padding: 8rpx 0;
  font-size: 26rpx;
}
.pay-btn {
  margin-top: 20rpx;
}

.reserve-at {
  color: var(--gold);
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.cancel-reason {
  font-size: 24rpx;
  margin-top: 8rpx;
}

.star-note {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
  font-size: 24rpx;
}
.star-note .muted {
  flex: 1;
}
