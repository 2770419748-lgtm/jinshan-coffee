.profile {
  display: flex;
  align-items: center;
  padding: 24rpx 8rpx 36rpx;
}
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 2rpx solid var(--gold);
  margin-right: 28rpx;
}
.hello {
  font-size: 36rpx;
  font-weight: 600;
}
.sub {
  font-size: 24rpx;
  margin-top: 6rpx;
}
.assets {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 28rpx 0;
  border-radius: 20rpx;
  border: 1rpx solid rgba(214, 178, 94, 0.45);
  background: linear-gradient(135deg, #2a2316 0%, #171615 70%);
}
.asset {
  flex: 1;
  text-align: center;
}
.asset-split {
  width: 1rpx;
  height: 64rpx;
  background: rgba(214, 178, 94, 0.3);
}
.asset-num {
  color: var(--gold);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
}
.asset-unit {
  font-size: 26rpx;
  font-weight: 600;
}
.asset-label {
  color: var(--text-2);
  font-size: 24rpx;
  margin-top: 6rpx;
}
.list {
  padding-top: 0;
  padding-bottom: 0;
}
.small {
  font-size: 24rpx;
  margin-top: 6rpx;
}
.server-switch {
  text-align: center;
  color: var(--text-3);
  font-size: 24rpx;
  margin-top: 40rpx;
}
.server-test { color: #d03050; font-weight: 600; }
.server-prod { color: var(--gold); font-weight: 600; }
.staff-link {
  text-align: center;
  color: var(--text-3);
  font-size: 24rpx;
  margin-top: 40rpx;
  text-decoration: underline;
}
