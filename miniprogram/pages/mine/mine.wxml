<wxs src="../../utils/filters.wxs" module="f" />

<view class="page">
  <view class="profile">
    <image class="avatar" src="/images/logo.jpg" mode="aspectFill" />
    <view class="flex-1">
      <view class="hello">欢迎来进山</view>
      <view class="muted sub" wx:if="{{user && user.staff}}">{{user.staff.name}} · {{user.staff.roleName}}</view>
      <view class="muted sub" wx:elif="{{member && member.isMember}}">进山会员 · {{member.memberUntil}} 到期</view>
      <view class="faint sub" wx:else>咖啡和书，慢慢来</view>
    </view>
  </view>

  <!-- 余额和集星：点进会员中心、集星页 -->
  <view class="assets" wx:if="{{member || stars}}">
    <view class="asset" wx:if="{{member}}" bindtap="goMember" hover-class="btn-hover">
      <view class="asset-num"><text class="asset-unit">¥</text>{{f.yuan(member.balance)}}</view>
      <view class="asset-label">{{member.isMember ? '会员余额' : '余额'}} ›</view>
    </view>
    <view class="asset-split" wx:if="{{member && stars}}"></view>
    <view class="asset" wx:if="{{stars}}" bindtap="goStars" hover-class="btn-hover">
      <view class="asset-num">{{stars.stars}}<text class="asset-unit"> / {{stars.need}}</text></view>
      <view class="asset-label">集星 ›</view>
    </view>
  </view>

  <view class="card list">
    <view class="cell cell-arrow" bindtap="goOrders" hover-class="btn-hover">
      <text class="flex-1">咖啡订单</text>
    </view>
    <view class="cell cell-arrow" bindtap="goRentals" hover-class="btn-hover">
      <text class="flex-1">借书记录</text>
    </view>
  </view>

  <view class="card list">
    <view class="cell cell-arrow" bindtap="goVouchers" hover-class="btn-hover">
      <text class="flex-1">我的券</text>
    </view>
    <view class="cell cell-arrow" bindtap="goCoupons" hover-class="btn-hover">
      <text class="flex-1">领券中心</text>
    </view>
    <view class="cell cell-arrow" wx:if="{{delivery}}" bindtap="goAddresses" hover-class="btn-hover">
      <text class="flex-1">收货地址</text>
    </view>
  </view>

  <view class="card list" wx:if="{{user && user.staff}}">
    <view class="cell cell-arrow" bindtap="goAdmin" hover-class="btn-hover">
      <text class="flex-1 gold">管理后台</text>
      <text class="faint small">{{user.staff.roleName}}</text>
    </view>
  </view>

  <view class="card list" wx:if="{{user && !user.hasOwner}}">
    <view class="cell cell-arrow" bindtap="bindOwner" hover-class="btn-hover">
      <view class="flex-1">
        <view class="gold">店主绑定</view>
        <view class="faint small">店里还没有店主。店主第一次使用时点这里，绑定后这个入口会消失。</view>
      </view>
    </view>
  </view>

  <view class="staff-link" wx:if="{{user && !user.staff && user.hasOwner}}" bindtap="bindStaff">我是店员，用邀请码绑定</view>

  <view class="server-switch" wx:if="{{server}}" bindtap="switchServer">
    <text class="{{server === 'test' ? 'server-test' : 'server-prod'}}">{{server === 'test' ? '测试服务器' : '正式服务器'}}</text>
    <text>{{server === 'test' ? '（数据和正式版分开）· 切到正式' : '（店里的真数据）· 切回测试'}}</text>
  </view>
</view>
