/* 黑镜车体护理车房：黑底白字，跟 logo 一致 */
page {
  --bg: #000000;
  --card: #111111;
  --card-2: #1c1c1c;
  --line: #262626;
  --accent: #ffffff;
  --accent-soft: rgba(255, 255, 255, 0.1);
  --text: #f2f2f2;
  --text-2: #9a9a9a;
  --text-3: #666666;
  --danger: #ff6b5a;
  --ok: #6fcf8a;
  --warn: #f2b84b;

  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

view, text, input, textarea, button, scroll-view {
  box-sizing: border-box;
}

.page {
  padding: 24rpx 24rpx 48rpx;
}

.card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 26rpx;
  color: var(--text-2);
  margin: 12rpx 4rpx 16rpx;
}

.accent { color: var(--accent); font-weight: 600; }
.muted { color: var(--text-2); }
.faint { color: var(--text-3); }
.danger { color: var(--danger); }
.ok { color: var(--ok); }
.warn { color: var(--warn); }
.small { font-size: 24rpx; }
.bold { font-weight: 600; }

.price {
  color: var(--accent);
  font-weight: 600;
}
.price::before {
  content: "¥";
  font-size: 0.75em;
  margin-right: 2rpx;
}
.price.big { font-size: 40rpx; }
.price.strike {
  color: var(--text-3);
  font-weight: 400;
  text-decoration: line-through;
  font-size: 24rpx;
}

.btn-main,
.btn-ghost,
.btn-danger {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  padding: 0 40rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.btn-main { background: var(--accent); color: #000; }
.btn-ghost { border: 1rpx solid var(--accent); color: var(--accent); }
.btn-danger { border: 1rpx solid var(--danger); color: var(--danger); }
.btn-block { display: flex; width: 100%; }
.btn-small { height: 60rpx; padding: 0 28rpx; font-size: 26rpx; border-radius: 30rpx; }
.btn-main.disabled, .btn-ghost.disabled { opacity: 0.35; }
.btn-hover { opacity: 0.7; }
.btn-gap { margin-top: 20rpx; }

.tag {
  display: inline-block;
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  background: var(--card-2);
  color: var(--text-2);
  margin-right: 8rpx;
}
.tag.on { background: var(--accent); color: #000; }
.tag.danger { background: rgba(255, 107, 90, 0.15); color: var(--danger); }
.tag.ok { background: rgba(111, 207, 138, 0.15); color: var(--ok); }
.tag.warn { background: rgba(242, 184, 75, 0.15); color: var(--warn); }

.empty {
  text-align: center;
  color: var(--text-3);
  padding: 80rpx 0;
}

.row {
  display: flex;
  align-items: center;
}
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.flex-1 { flex: 1; min-width: 0; }

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.cell:last-child { border-bottom: none; }
.cell-arrow::after {
  content: "›";
  color: var(--text-3);
  font-size: 36rpx;
  margin-left: 12rpx;
}

/* 底部弹层 */
.mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  z-index: 90;
}
.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  max-height: 80vh;
  overflow-y: auto;
  background: var(--card);
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  z-index: 100;
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.sheet-title { font-size: 34rpx; font-weight: 600; }
.sheet-close { font-size: 44rpx; color: var(--text-3); padding: 0 8rpx; }

/* 表单 */
.field {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.field:last-child { border-bottom: none; }
.field-label {
  width: 160rpx;
  color: var(--text-2);
  flex-shrink: 0;
}
.field-input {
  flex: 1;
  color: var(--text);
  font-size: 28rpx;
}
.placeholder { color: var(--text-3); }

.chips {
  display: flex;
  flex-wrap: wrap;
}
.chip {
  padding: 12rpx 28rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 12rpx;
  border: 1rpx solid var(--line);
  background: var(--card-2);
  color: var(--text);
  font-size: 26rpx;
}
.chip.on {
  border-color: var(--accent);
  background: var(--accent);
  color: #000;
  font-weight: 600;
}
.chip.off {
  color: var(--text-3);
  text-decoration: line-through;
}

/* 选项（付款方式、次卡等）：一行一个，右边圆点 */
.option {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.option:last-child { border-bottom: none; }
.option.off { opacity: 0.4; }
.dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid var(--text-3);
  flex-shrink: 0;
  margin-left: 16rpx;
}
.dot.on {
  border: 10rpx solid var(--accent);
}

/* 底部固定的操作条 */
.bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #0a0a0a;
  border-top: 1rpx solid var(--line);
  z-index: 50;
}
.safe-bottom { height: calc(140rpx + env(safe-area-inset-bottom)); }

/* 页内标签切换 */
.tabs {
  display: flex;
  background: var(--card);
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 12rpx;
  color: var(--text-2);
}
.tab.on {
  background: var(--accent);
  color: #000;
  font-weight: 600;
}
