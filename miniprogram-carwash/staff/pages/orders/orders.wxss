.entries { display: flex; gap: 20rpx; margin-bottom: 24rpx; }
.entry {
  flex: 1;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 24rpx;
  font-weight: 600;
}
.days { margin-bottom: 8rpx; }
.time { font-size: 34rpx; font-weight: 700; }
.order .row { margin-top: 8rpx; }
.foot { margin-top: 12rpx; }
