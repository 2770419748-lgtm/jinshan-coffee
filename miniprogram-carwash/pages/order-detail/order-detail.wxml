<wxs src="../../utils/filters.wxs" module="f" />

<view class="page" wx:if="{{order}}">
  <view class="card head">
    <view class="status">{{order.statusText}}</view>
    <view class="muted">{{hint}}</view>
    <view class="warn small" wx:if="{{order.payDeadline}}">请在 {{f.clock(order.payDeadline)}} 前付款，不付会自动取消</view>
  </view>

  <view class="card">
    <view class="row-between">
      <view class="bold big">{{order.serviceName}}</view>
      <text class="tag">{{order.modeText}}</text>
    </view>
    <view class="cell">
      <text class="muted">时间</text>
      <text>{{order.slotLabel}}</text>
    </view>
    <view class="cell" wx:if="{{order.address}}">
      <text class="muted">地址</text>
      <view class="right">
        <view>{{order.address.place}} {{order.address.detail}}</view>
        <view class="faint small">{{order.address.name}} {{order.address.phone}}</view>
      </view>
    </view>
    <view class="cell" wx:if="{{order.plate || order.carModel}}">
      <text class="muted">车</text>
      <text>{{order.plate}} {{order.carModel}}</text>
    </view>
    <view class="cell" wx:if="{{order.techName}}">
      <text class="muted">技师</text>
      <text>{{order.techName}}</text>
    </view>
    <view class="cell" wx:if="{{order.remark}}">
      <text class="muted">备注</text>
      <text>{{order.remark}}</text>
    </view>
  </view>

  <view class="card">
    <view class="cell">
      <text class="muted">{{order.memberPriced ? '项目（会员价）' : '项目'}}</text>
      <text class="price">{{f.yuan(order.unitPrice)}}</text>
    </view>
    <view class="cell" wx:if="{{order.mode === 'door'}}">
      <text class="muted">上门费（{{order.distanceKm}} 公里）</text>
      <text class="price">{{f.yuan(order.doorFee + order.extraFee)}}</text>
    </view>
    <view class="cell" wx:if="{{order.cardCover}}">
      <text class="muted">次卡「{{order.cardName}}」抵扣</text>
      <text>-¥{{f.yuan(order.cardCover)}}</text>
    </view>
    <view class="cell">
      <text class="muted">应付</text>
      <text class="price big">{{f.yuan(order.payFee)}}</text>
    </view>
    <view class="cell">
      <text class="muted">付款</text>
      <text>{{f.payText(order)}}</text>
    </view>
    <view class="cell" wx:if="{{order.status === 'cancelled'}}">
      <text class="muted">取消</text>
      <text class="right">{{order.cancelReason}}<text wx:if="{{order.cancelFee}}">，扣 ¥{{f.yuan(order.cancelFee)}}</text></text>
    </view>
    <view class="faint small">单号 {{order.orderNo}} · 下单 {{f.time(order.createdAt)}}</view>
  </view>

  <view class="card" wx:if="{{order.payWays}}">
    <view class="section-title">现在付款</view>
    <view class="btn-main btn-block" wx:if="{{order.payWays.wechat}}" bindtap="payWechat">微信支付 ¥{{f.yuan(order.payFee)}}</view>
    <view class="btn-ghost btn-block btn-gap {{order.payWays.balanceLeft >= order.payFee ? '' : 'disabled'}}" wx:if="{{order.payWays.balance}}" bindtap="payBalance">洗车余额付（余额 ¥{{f.yuan(order.payWays.balanceLeft)}}）</view>
    <view class="faint small btn-gap" wx:if="{{!order.awaitingPay}}">也可以洗完付给技师。</view>
  </view>

  <view class="btn-main btn-block btn-gap" wx:if="{{order.status === 'done'}}" bindtap="confirmDone">确认洗好了</view>
  <view class="btn-danger btn-block btn-gap" wx:if="{{order.cancel && order.cancel.allowed}}" bindtap="cancel">取消预约</view>
  <view class="faint small center btn-gap" wx:if="{{order.cancel && !order.cancel.allowed}}">{{order.cancel.reason}}</view>
  <view class="btn-ghost btn-block btn-gap" wx:if="{{order.shop && order.shop.phone}}" bindtap="callShop">打电话给店里</view>

  <view class="card policy btn-gap" wx:if="{{order.policy.length}}">
    <view class="small faint" wx:for="{{order.policy}}" wx:key="*this">· {{item}}</view>
  </view>
</view>
<view class="empty" wx:elif="{{error}}">{{error}}</view>
