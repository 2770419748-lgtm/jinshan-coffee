<view class="page">
  <view class="card">
    <view class="intro">输入店长给你的 6 位邀请码。邀请码 24 小时内有效，只能用一次。</view>
    <view class="field">
      <text class="field-label">称呼</text>
      <input class="field-input" placeholder="比如 小张" placeholder-class="placeholder" maxlength="12" value="{{name}}" bindinput="onName" />
    </view>
    <view class="field">
      <text class="field-label">邀请码</text>
      <input class="field-input" type="number" placeholder="6 位数字" placeholder-class="placeholder" maxlength="6" value="{{code}}" bindinput="onCode" />
    </view>
  </view>
  <view class="btn-main btn-block {{submitting ? 'disabled' : ''}}" bindtap="submit">{{submitting ? '绑定中…' : '确认绑定'}}</view>
</view>
