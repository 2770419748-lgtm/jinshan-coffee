<wxs src="../../utils/filters.wxs" module="f" />

<view class="hero">
  <image class="banner" src="/images/banner.jpg" mode="aspectFill" />
</view>

<view class="page">
  <view class="card shop" wx:if="{{shop}}">
    <view class="shop-name">{{shop.shopName || shopName}}</view>
    <view class="muted small" wx:if="{{shop.hours}}">营业 {{shop.hours.open}} - {{shop.hours.close}}</view>
    <view class="shop-row" wx:if="{{shop.address}}" bindtap="openMap" hover-class="btn-hover">
      <text class="flex-1">{{shop.address}}</text>
      <text class="link" wx:if="{{shop.location}}">导航</text>
    </view>
    <view class="shop-row" wx:if="{{shop.phone}}" bindtap="callShop" hover-class="btn-hover">
      <text class="flex-1">{{shop.phone}}</text>
      <text class="link">打电话</text>
    </view>
    <view class="notice" wx:if="{{shop.notice}}">{{shop.notice}}</view>
  </view>

  <view class="card member" wx:if="{{member && member.enabled}}" bindtap="goMember" hover-class="btn-hover">
    <view class="flex-1">
      <view class="muted small">洗车余额</view>
      <view class="price big">{{f.yuan(member.balance)}}</view>
    </view>
    <view class="member-side">
      <view class="tag on" wx:if="{{member.isMember}}">会员价</view>
      <view class="muted small" wx:if="{{member.cards}}">次卡 {{member.cards}} 张</view>
      <view class="muted small">充值 / 办卡 ›</view>
    </view>
  </view>

  <view class="closed" wx:if="{{loaded && !bookingOpen}}">店里暂时没开放线上预约，可以先看看项目和价格，或者打电话预约。</view>

  <view class="section-title" wx:if="{{services.length}}">服务项目</view>
  <view class="card service" wx:for="{{services}}" wx:key="_id" data-id="{{item._id}}" bindtap="book" hover-class="btn-hover">
    <image class="cover" wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" />
    <view class="flex-1">
      <view class="service-name">{{item.name}}</view>
      <view class="muted small" wx:if="{{item.desc}}">{{item.desc}}</view>
      <view class="faint small">{{f.modes(item.modes)}}<text wx:if="{{item.minutes}}"> · 约 {{f.minutes(item.minutes)}}</text></view>
      <view class="row prices">
        <text class="price">{{f.yuan(item.price)}}</text>
        <text class="member-price" wx:if="{{item.memberPrice !== null}}">会员 ¥{{f.yuan(item.memberPrice)}}</text>
      </view>
    </view>
    <view class="btn-main btn-small {{bookingOpen ? '' : 'disabled'}}">预约</view>
  </view>
  <view class="empty" wx:if="{{loaded && !services.length}}">店里还没上架服务项目</view>
</view>
